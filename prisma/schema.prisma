generator client {
  provider        = "prisma-client-js"
  // relationJoins：用单条 LATERAL JOIN 取关联数据，避免每个 include 各发一次往返
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider     = "postgresql"
  // 运行时走 6543 连接池(DATABASE_URL)；迁移走 5432 直连(DIRECT_URL)
  url          = env("DATABASE_URL")
  directUrl    = env("DIRECT_URL")
  relationMode = "prisma"
}

model User {
  /// 主键，建议使用 cuid 提高安全性 
  id            String        @id @default(cuid())
  /// 用户名，全局唯一 
  username      String        @unique
  /// 邮箱，全局唯一 
  email         String        @unique
  /// 加密后的哈希密码 (第三方登录注册时可为空) 
  password      String?
  /// 昵称 
  nickname      String?
  /// 头像 URL 
  avatar        String?
  /// 个人简介 
  bio           String?
  /// 性别：0-保密, 1-男, 2-女 
  gender        Int           @default(0)
  /// 角色：USER(普通用户), ADMIN(管理员) 
  role          Role          @default(USER)
  /// 是否激活 (用于管理员手动冻结账号) 
  isActive      Boolean       @default(true) @map("is_active")
  /// 0: 正常, 2: 被删除 
  isDelete      Int           @default(0) @map("is_delete")
  /// 记录删除的具体时间 
  deletedAt     DateTime?     @db.Timestamptz @map("deleted_at")
  /// 邮箱验证时间 (非空则表示已验证) 
  emailVerified DateTime?     @db.Timestamptz @map("email_verified")
  /// 手机号 (可选扩展) 
  phone         String?       @unique
  /// 手机验证时间 
  phoneVerified DateTime?     @db.Timestamptz @map("phone_verified")
  /// 注册时间 
  createdAt     DateTime      @db.Timestamptz @default(now()) @map("created_at")
  /// 最后一次修改资料时间 
  updatedAt     DateTime      @db.Timestamptz @updatedAt @map("updated_at")
  /// 最后一次登录时间 
  lastLoginAt   DateTime?     @db.Timestamptz @map("last_login_at")
  /// 最后一次登录 IP 
  lastLoginIp   String?       @map("last_login_ip")
  accounts      Account[]
  posts         Post[]
  comments      Comment[]
  interactions  Interaction[]

  @@index([isDelete])
  @@index([email, username])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @map("refresh_token")
  accessToken       String? @map("access_token")
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token")
  sessionState      String? @map("session_state")
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  color       String?
  createdAt   DateTime @db.Timestamptz @default(now()) @map("created_at")
  updatedAt   DateTime @db.Timestamptz @updatedAt @map("updated_at")
  posts       Post[]

  @@map("categories")
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @db.Timestamptz @default(now()) @map("created_at")
  updatedAt DateTime @db.Timestamptz @updatedAt @map("updated_at")
  posts     Post[]

  @@map("tags")
}

model Post {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  content      String
  excerpt      String?
  coverImage   String?       @map("cover_image")
  status       PostStatus    @default(DRAFT)
  viewCount    Int           @default(0) @map("view_count")
  userId       String        @map("user_id")
  categoryId   String?       @map("category_id")
  publishedAt  DateTime?     @db.Timestamptz @map("published_at")
  createdAt    DateTime      @db.Timestamptz @default(now()) @map("created_at")
  updatedAt    DateTime      @db.Timestamptz @updatedAt @map("updated_at")
  user         User          @relation(fields: [userId], references: [id])
  category     Category?     @relation(fields: [categoryId], references: [id])
  tags         Tag[]
  comments     Comment[]
  interactions Interaction[]

  @@index([userId])
  @@index([categoryId])
  @@map("posts")
}

model Comment {
  id        String    @id @default(cuid())
  content   String
  userId    String    @map("user_id")
  postId    String    @map("post_id")
  parentId  String?   @map("parent_id")
  isEdited  Boolean   @default(false) @map("is_edited")
  createdAt DateTime  @db.Timestamptz @default(now()) @map("created_at")
  updatedAt DateTime  @db.Timestamptz @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentToComment", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replies   Comment[] @relation("CommentToComment")

  @@index([postId])
  @@index([userId])
  @@index([parentId])
  @@map("comments")
}

model Interaction {
  id        String          @id @default(cuid())
  type      InteractionType
  userId    String          @map("user_id")
  postId    String          @map("post_id")
  createdAt DateTime        @db.Timestamptz @default(now()) @map("created_at")
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post            @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId, type])
  @@index([postId])
  @@index([userId])
  @@map("interactions")
}

model FriendLink {
  id          String           @id @default(cuid())
  name        String
  url         String
  description String?
  logo        String?
  coverImage  String?          @map("cover_image")
  email       String?
  status      FriendLinkStatus @default(PENDING)
  createdAt   DateTime         @db.Timestamptz @default(now()) @map("created_at")
  updatedAt   DateTime         @db.Timestamptz @updatedAt @map("updated_at")

  @@map("friend_links")
}

model AiTool {
  id          String       @id @default(cuid())
  name        String
  description String
  url         String
  icon        String?
  coverImage  String?      @map("cover_image")
  category    String
  tags        String?
  status      AiToolStatus @default(PENDING)
  createdAt   DateTime     @db.Timestamptz @default(now()) @map("created_at")
  updatedAt   DateTime     @db.Timestamptz @updatedAt @map("updated_at")

  @@map("ai_tools")
}

model Tool {
  id          String     @id @default(cuid())
  name        String
  description String
  icon        String?
  version     String?
  status      ToolStatus @default(NORMAL)
  type        ToolType   @default(EXTERNAL)
  url         String
  category    String
  createdAt   DateTime   @db.Timestamptz @default(now()) @map("created_at")
  updatedAt   DateTime   @db.Timestamptz @updatedAt @map("updated_at")

  @@map("tools")
}

model SiteVisit {
  id        Int      @id @default(autoincrement())
  uv        String   @map("uv")
  pageUrl   String   @map("page_url")
  device    String
  referrer  String?
  ip        String
  createdAt DateTime @db.Timestamptz @default(now()) @map("created_at")

  @@index([uv])
  @@index([pageUrl])
  @@index([createdAt])
  @@map("site_visits")
}

model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime @db.Timestamptz
  createdAt DateTime @db.Timestamptz @default(now())
  used      Boolean  @default(false)

  @@index([email, createdAt])
  @@map("verification_codes")
}

model EmailLog {
  id           String      @id @default(cuid())
  fromEmail    String      @map("from_email")
  toEmail      String      @map("to_email")
  subject      String
  content      String?
  status       EmailStatus @default(PENDING)
  errorMessage String?     @map("error_message")
  ip           String
  sendCount    Int         @default(1) @map("send_count")
  createdAt    DateTime    @db.Timestamptz @default(now()) @map("created_at")
  sentAt       DateTime?   @db.Timestamptz @map("sent_at")

  @@index([ip])
  @@index([createdAt])
  @@index([status])
  @@map("email_logs")
}

enum Role {
  USER
  ADMIN
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum InteractionType {
  LIKE
  FAVORITE
}

enum FriendLinkStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AiToolStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ToolType {
  LOCAL
  EXTERNAL
}

enum ToolStatus {
  PENDING
  NORMAL
  DEBUG
  UPDATE
  MAINTENANCE
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

model PromptTemplate {
  id            String                 @id @default(cuid())
  /// 模板标题
  title         String
  /// 简短描述
  description   String
  /// 提示词正文
  content       String
  /// 分类（如：写作、编程、翻译...）
  category      String
  /// 逗号分隔标签
  tags          String?
  /// 提交者昵称
  author        String?
  /// 提交者邮箱
  email         String?
  /// 审核状态
  status        PromptTemplateStatus   @default(PENDING)
  /// 浏览次数
  viewCount     Int                    @default(0) @map("view_count")
  /// 点赞次数
  likeCount     Int                    @default(0) @map("like_count")
  /// 使用次数（复制次数）
  useCount      Int                    @default(0) @map("use_count")
  createdAt     DateTime               @db.Timestamptz @default(now()) @map("created_at")
  updatedAt     DateTime               @db.Timestamptz @updatedAt @map("updated_at")
  likes         PromptLike[]
  comments      PromptComment[]

  @@index([category])
  @@index([status])
  @@index([status, category])
  @@index([likeCount])
  @@map("prompt_templates")
}

model PromptLike {
  id         String   @id @default(cuid())
  templateId String   @map("template_id")
  /// 用户 IP（未登录用户用 IP 去重）
  ip         String?
  createdAt  DateTime @db.Timestamptz @default(now()) @map("created_at")
  template   PromptTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, ip])
  @@index([templateId])
  @@map("prompt_likes")
}

model PromptComment {
  id         String   @id @default(cuid())
  templateId String   @map("template_id")
  /// 评论者昵称
  author     String
  /// 评论内容
  content    String
  createdAt  DateTime @db.Timestamptz @default(now()) @map("created_at")
  template   PromptTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("prompt_comments")
}

enum PromptTemplateStatus {
  PENDING
  APPROVED
  REJECTED
}

/// 额度码状态（评论抽奖奖池）
enum CreditCodeStatus {
  /// 待领取（在池中）
  AVAILABLE
  /// 已领取
  CLAIMED
  /// 已作废（如批量停用）
  DISABLED
}

/// 公益站审核状态
enum StationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// 额度码（评论抽奖奖池，按批次导入）。码本身由外部网关生成，本表仅存储展示。
model CreditCode {
  id        String          @id @default(cuid())
  /// 平台下发的额度码（明文存储，用户领取后展示）
  code      String          @unique
  /// 该批次额度（美元，如 5 表示 $5）
  amount    Decimal         @db.Decimal(10, 2)
  status    CreditCodeStatus @default(AVAILABLE)
  /// 领取时的评论 id（便于溯源）
  commentId String?         @map("comment_id")
  /// 领取者 IP（限领一次用）
  claimIp   String?         @map("claim_ip")
  /// 所属批次 id（每批导入统一生成，便于分批管理与设置活动批次）
  batchId   String          @map("batch_id")
  /// 所属批次备注
  batchNote String?         @map("batch_note")
  createdAt DateTime        @db.Timestamptz @default(now()) @map("created_at")
  updatedAt DateTime        @db.Timestamptz @updatedAt @map("updated_at")

  @@index([status])
  @@index([batchId])
  @@index([createdAt])
  @@map("credit_codes")
}

/// 评论抽奖活动配置（单例，记录当前抽奖使用的批次）
model CreditActivityConfig {
  /// 固定单例行 id
  id            String   @id @default("singleton")
  /// 当前活动抽奖批次 id（null 表示不限批次，从全部 AVAILABLE 中抽取）
  activeBatchId String?  @map("active_batch_id")
  /// 公益站额度兑换入口地址（邮件按钮/前台跳转优先使用，未配置则兜底默认地址）
  redeemUrl     String?  @map("redeem_url")
  updatedAt     DateTime @db.Timestamptz @updatedAt @map("updated_at")

  @@map("credit_activity_config")
}

/// 评论领额度活动页的评论（提交即上墙）
model CreditComment {
  id        String   @id @default(cuid())
  /// 评论者昵称
  nickname  String
  /// 评论内容
  content   String
  /// 评论者 IP（限领一次用）
  ip        String
  /// 是否已抽中额度码（true 表示本次领取了 creditCodes 中一条）
  claimed   Boolean  @default(false)
  /// 抽中的额度码（claimed 为 true 时有效）
  code      String?
  /// 抽中的额度（美元）
  amount    Decimal? @db.Decimal(10, 2)
  createdAt DateTime @db.Timestamptz @default(now()) @map("created_at")

  @@index([ip])
  @@index([createdAt])
  @@map("credit_comments")
}

/// 共建公益站提交记录（与评论奖池完全独立，额度码由管理员手动粘贴下发）
model PublicStation {
  id         String       @id @default(cuid())
  /// 提交者邮箱（必填，审核通过时发通知用）
  email      String
  /// 站点地址（审核通过后即用户跳转的目标 url）
  url        String
  /// 站点 key（脱敏展示）
  keyValue   String       @map("key_value")
  /// 支持模型（自由文本，如 "gpt-4o, claude-3.5"）
  models     String
  /// 用户提取码（提交后生成，用于前台查询审核进度）
  extractCode String      @map("extract_code")
  status     StationStatus @default(PENDING)
  /// 审核通过后下发的额度码（管理员手动粘贴，随邮件发出）
  creditCode String?      @map("credit_code")
  /// 额度（美元，Decimal）
  amount     Decimal?     @db.Decimal(10, 2)
  /// 失效时间（用户需在失效前兑换）
  expireAt   DateTime?    @db.Timestamptz @map("expire_at")
  /// 审核备注
  reviewNote String?      @map("review_note")
  /// 最近一次重发邮件时间（用于限制每记录每天仅可重发一次）
  lastEmailedAt DateTime? @db.Timestamptz @map("last_emailed_at")
  createdAt  DateTime     @db.Timestamptz @default(now()) @map("created_at")
  reviewedAt DateTime?    @db.Timestamptz @map("reviewed_at")

  @@unique([extractCode])
  @@index([status])
  @@map("public_stations")
}
