generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  /// 主键，建议使用 cuid 提高安全性 
  id            String        @id @default(cuid())
  /// 用户名，全局唯一 
  username      String        @unique
  /// 邮箱，全局唯一 
  email         String        @unique
  /// 加密后的哈希密码 (第三方登录注册时可为空) 
  password      String?
  /// 昵称 
  nickname      String?
  /// 头像 URL 
  avatar        String?
  /// 个人简介 
  bio           String?
  /// 性别：0-保密, 1-男, 2-女 
  gender        Int           @default(0)
  /// 角色：USER(普通用户), ADMIN(管理员) 
  role          Role          @default(USER)
  /// 是否激活 (用于管理员手动冻结账号) 
  isActive      Boolean       @default(true) @map("is_active")
  /// 0: 正常, 2: 被删除 
  isDelete      Int           @default(0) @map("is_delete")
  /// 记录删除的具体时间 
  deletedAt     DateTime?     @map("deleted_at")
  /// 邮箱验证时间 (非空则表示已验证) 
  emailVerified DateTime?     @map("email_verified")
  /// 手机号 (可选扩展) 
  phone         String?       @unique
  /// 手机验证时间 
  phoneVerified DateTime?     @map("phone_verified")
  /// 注册时间 
  createdAt     DateTime      @default(now()) @map("created_at")
  /// 最后一次修改资料时间 
  updatedAt     DateTime      @updatedAt @map("updated_at")
  /// 最后一次登录时间 
  lastLoginAt   DateTime?     @map("last_login_at")
  /// 最后一次登录 IP 
  lastLoginIp   String?       @map("last_login_ip")
  accounts      Account[]
  posts         Post[]
  comments      Comment[]
  interactions  Interaction[]

  @@index([isDelete])
  @@index([email, username])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @map("refresh_token")
  accessToken       String? @map("access_token")
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token")
  sessionState      String? @map("session_state")
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  color       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  posts       Post[]

  @@map("categories")
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  posts     Post[]

  @@map("tags")
}

model Post {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  content      String
  excerpt      String?
  coverImage   String?       @map("cover_image")
  status       PostStatus    @default(DRAFT)
  viewCount    Int           @default(0) @map("view_count")
  userId       String        @map("user_id")
  categoryId   String?       @map("category_id")
  publishedAt  DateTime?     @map("published_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  user         User          @relation(fields: [userId], references: [id])
  category     Category?     @relation(fields: [categoryId], references: [id])
  tags         Tag[]
  comments     Comment[]
  interactions Interaction[]

  @@index([userId])
  @@index([categoryId])
  @@map("posts")
}

model Comment {
  id        String    @id @default(cuid())
  content   String
  userId    String    @map("user_id")
  postId    String    @map("post_id")
  parentId  String?   @map("parent_id")
  isEdited  Boolean   @default(false) @map("is_edited")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentToComment", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replies   Comment[] @relation("CommentToComment")

  @@index([postId])
  @@index([userId])
  @@index([parentId])
  @@map("comments")
}

model Interaction {
  id        String          @id @default(cuid())
  type      InteractionType
  userId    String          @map("user_id")
  postId    String          @map("post_id")
  createdAt DateTime        @default(now()) @map("created_at")
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post            @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId, type])
  @@index([postId])
  @@index([userId])
  @@map("interactions")
}

model FriendLink {
  id          String           @id @default(cuid())
  name        String
  url         String
  description String?
  logo        String?
  coverImage  String?          @map("cover_image")
  email       String?
  status      FriendLinkStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("friend_links")
}

model AiTool {
  id          String       @id @default(cuid())
  name        String
  description String
  url         String
  icon        String?
  coverImage  String?      @map("cover_image")
  category    String
  tags        String?
  status      AiToolStatus @default(PENDING)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("ai_tools")
}

model Tool {
  id          String     @id @default(cuid())
  name        String
  description String
  icon        String?
  version     String?
  status      ToolStatus @default(NORMAL)
  type        ToolType   @default(EXTERNAL)
  url         String
  category    String
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("tools")
}

model SiteVisit {
  id        Int      @id @default(autoincrement())
  uv        String   @map("uv")
  pageUrl   String   @map("page_url")
  device    String
  referrer  String?
  ip        String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([uv])
  @@index([pageUrl])
  @@index([createdAt])
  @@map("site_visits")
}

enum Role {
  USER
  ADMIN
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum InteractionType {
  LIKE
  FAVORITE
}

enum FriendLinkStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AiToolStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ToolType {
  LOCAL
  EXTERNAL
}

enum ToolStatus {
  PENDING
  NORMAL
  DEBUG
  UPDATE
  MAINTENANCE
}
